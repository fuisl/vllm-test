# Required
HF_TOKEN=your_huggingface_token_here

# LLM model served by vllm-llm (default: Qwen/Qwen3-8B)
# Use Qwen/Qwen3-4B-Instruct-2507 to save VRAM
LLM_MODEL=Qwen/Qwen3-8B

# OCR model (default: deepseek-ai/DeepSeek-OCR-2)
OCR_MODEL=deepseek-ai/DeepSeek-OCR-2
OCR_BASE_SIZE=1024
OCR_IMAGE_SIZE=768

# -----------------------------------------------------------------
# GPU memory budget for A100 80GB (all services share 1 GPU):
#   vllm-embed:   0.08  (~6 GB)
#   vllm-rerank:  0.08  (~6 GB)
#   vllm-llm:     0.40  (~32 GB — Qwen3-8B BF16 + KV cache)
#   ocr-service:  ~6 GB (DeepSeek-OCR-2 3B BF16 via transformers)
#   Total:        ~50 GB / 80 GB
# -----------------------------------------------------------------
